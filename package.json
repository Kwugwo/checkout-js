{
  "name": "@kwugwo/checkout",
  "version": "1.1.1",
  "description": "Embed Kwugwo Checkout into any website. Tiny iframe-based SDK with no runtime dependencies.",
  "keywords": [
    "kwugwo",
    "checkout",
    "payments",
    "embed",
    "sdk"
  ],
  "homepage": "https://github.com/Kwugwo/checkout-js#readme",
  "bugs": {
    "url": "https://github.com/Kwugwo/checkout-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kwugwo/checkout-js.git"
  },
  "license": "MIT",
  "author": "",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "browser": "./dist/kwugwo-checkout.global.min.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "build:dev": "cross-env BUILD_VARIANT=dev tsup",
    "build:prod": "cross-env BUILD_VARIANT=prod tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build:prod"
  },
  "dependencies": {
    "acorn": "^8.16.0",
    "any-promise": "^1.3.0",
    "bundle-require": "^5.1.0",
    "cac": "^6.7.14",
    "chokidar": "^4.0.3",
    "commander": "^4.1.1",
    "confbox": "^0.1.8",
    "consola": "^3.4.2",
    "cross-spawn": "^7.0.6",
    "debug": "^4.4.3",
    "esbuild": "^0.27.7",
    "fdir": "^6.5.0",
    "fix-dts-default-cjs-exports": "^1.0.1",
    "isexe": "^2.0.0",
    "joycon": "^3.1.1",
    "lilconfig": "^3.1.3",
    "lines-and-columns": "^1.2.4",
    "load-tsconfig": "^0.2.5",
    "magic-string": "^0.30.21",
    "mlly": "^1.8.2",
    "ms": "^2.1.3",
    "mz": "^2.7.0",
    "object-assign": "^4.1.1",
    "path-key": "^3.1.1",
    "pathe": "^2.0.3",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.4",
    "pirates": "^4.0.7",
    "pkg-types": "^1.3.1",
    "postcss-load-config": "^6.0.1",
    "readdirp": "^4.1.2",
    "resolve-from": "^5.0.0",
    "rollup": "^4.60.4",
    "shebang-command": "^2.0.0",
    "shebang-regex": "^3.0.0",
    "source-map": "^0.7.6",
    "sucrase": "^3.35.1",
    "thenify": "^3.3.1",
    "thenify-all": "^1.6.0",
    "tinyexec": "^0.3.2",
    "tinyglobby": "^0.2.16",
    "tree-kill": "^1.2.2",
    "ts-interface-checker": "^0.1.13",
    "ufo": "^1.6.4",
    "which": "^2.0.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "tsup": "^8.4.0",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "module": "./dist/index.js",
  "unpkg": "./dist/kwugwo-checkout.global.min.js",
  "jsdelivr": "./dist/kwugwo-checkout.global.min.js",
  "sideEffects": false
}
